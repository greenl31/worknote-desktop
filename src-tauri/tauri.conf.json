{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "工作日志 Worknote",
  "version": "0.5.0",
  "identifier": "io.github.greenl31.worknote",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "工作日志 Worknote",
        "url": "index.html?v=public-v050",
        "width": 480,
        "height": 680,
        "minWidth": 320,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "greenl31",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
